---
import Layout from '../layouts/Layout.astro';
import SkillCard from '../components/SkillCard.astro';
import SkillDetail from '../components/SkillDetail.astro';
import { getCollection } from 'astro:content';

const skills = (await getCollection('skills'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const personalSkills = skills.filter(s => s.data.type === 'personal');
const referenceSkills = skills.filter(s => s.data.type === 'reference');

const totalCount = skills.length;
const pageTitle = "Agent Skills | curated knowledge for AI agents";
const pageDescription = "Explore a collection of high-quality, practical skills designed for advanced AI agents, covering automation, coding, and design.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="relative">
    <!-- VIEW: LIST -->
    <div id="list-view" class="max-w-5xl mx-auto pt-8 pb-32 transition-all duration-500 ease-in-out will-change-transform">
        <!-- Header -->
        <header class="mb-12">
        <h1 class="text-4xl font-bold mb-3 text-notebook-ink tracking-tight">
            Agent Skills
        </h1>
        <p class="text-lg text-notebook-secondary font-medium">
            A collection of expert knowledge for AI agents.
        </p>
        </header>

        <!-- Search Section -->
        <div class="sticky top-4 z-20 mb-12">
        <div class="relative">
            <label for="skill-search" class="sr-only">Search skills by name or description</label>
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-notebook-secondary" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <input 
            type="text" 
            id="skill-search"
            placeholder="Search skills..." 
            class="w-full pl-11 pr-4 py-3 bg-white border border-notebook-decor focus:border-notebook-ink rounded-xl shadow-[0_2px_10px_-3px_rgba(0,0,0,0.07)] text-notebook-ink placeholder-notebook-secondary/60 focus:outline-none focus:ring-2 focus:ring-notebook-interactive/20 transition-all font-body text-base"
            autocomplete="off"
            />
            <div class="absolute inset-y-0 right-4 flex items-center">
                <span class="text-[10px] font-bold text-notebook-secondary bg-notebook-base px-2 py-1 rounded-xl border border-notebook-decor tabular-nums" id="count-badge">
                    {totalCount} TOTAL
                </span>
            </div>
        </div>
        </div>

        <!-- Personal Skills Section -->
        {personalSkills.length > 0 && (
            <section id="personal-section" class="mb-16">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-xs font-bold text-notebook-secondary uppercase tracking-[0.2em]">Crafted by Me</h2>
                    <div class="h-px bg-notebook-decor flex-1"></div>
                </div>
                <div class="flex flex-col gap-4">
                    {personalSkills.map(skill => (
                    <SkillCard skill={skill} />
                    ))}
                </div>
            </section>
        )}

        <!-- Reference Skills Section -->
        {referenceSkills.length > 0 && (
            <section id="reference-section" class="mb-16">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-xs font-bold text-notebook-secondary uppercase tracking-[0.2em]">External Reference</h2>
                    <div class="h-px bg-notebook-decor flex-1"></div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {referenceSkills.map(skill => (
                    <SkillCard skill={skill} />
                    ))}
                </div>
            </section>
        )}

        <!-- Empty State -->
        <div id="empty-state" class="hidden text-center py-20">
            <p class="text-notebook-secondary font-medium text-lg">No matches found.</p>
            <button id="clear-search" class="mt-4 px-6 py-2.5 bg-notebook-ink text-notebook-base rounded-xl hover:bg-notebook-interactive active:scale-95 transition-all duration-300 ease-out text-sm font-bold shadow-sm">
              Clear all filters
            </button>
        </div>
    </div>

    <div id="details-container" class="hidden w-full z-30 transition-all duration-500 ease-in-out opacity-0 translate-y-4 will-change-transform">
        {personalSkills.map(skill => (
            <SkillDetail skill={skill} />
        ))}
    </div>

    <!-- Floating Back to Top -->
    <button 
        id="back-to-top" 
        class="fixed bottom-8 right-8 p-4 bg-notebook-ink text-notebook-base rounded-xl shadow-xl hover:bg-notebook-interactive transition-all duration-500 opacity-0 translate-y-10 pointer-events-none z-50 flex items-center justify-center transform-gpu"
        title="Back to Top"
        aria-label="Back to top"
    >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
  </main>

  <footer id="main-footer" class="mt-20 py-12 text-center text-notebook-secondary border-t border-notebook-decor">
    <div class="text-xs font-bold tracking-widest uppercase">
      <p class="mb-4">© 2026 Agent Skills Repository</p>
      <div class="flex justify-center gap-6">
        <a href="https://github.com/chiperman/agent-skills" target="_blank" rel="noopener noreferrer" class="hover:text-notebook-ink transition-colors" aria-label="Visit project GitHub">
          GitHub
        </a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const listView = document.getElementById('list-view');
  const detailsContainer = document.getElementById('details-container');
  const footer = document.getElementById('main-footer');
  const backToTopBtn = document.getElementById('back-to-top');
  const searchInput = document.getElementById('skill-search') as HTMLInputElement;
  const countBadge = document.getElementById('count-badge');
  const emptyState = document.getElementById('empty-state');
  const clearBtn = document.getElementById('clear-search');
  
  const ORIGIN_TITLE = document.title;
  let currentScrollPos = 0;
  let lastFocusedElement: HTMLElement | null = null;

  // --- ScrollSpy Logic ---
  let scrollSpyObserver: IntersectionObserver | null = null;
  let isManualScrolling = false;
  let manualScrollTimeout: number | null = null;

  function initScrollSpy(detailElement: HTMLElement) {
    if (scrollSpyObserver) scrollSpyObserver.disconnect();

    const tocLinks = detailElement.querySelectorAll('.toc-link');
    const headings = Array.from(detailElement.querySelectorAll('article h2, article h3, article h4'));
    
    // 1. Handle Click Highlighting
    tocLinks.forEach(link => {
        link.addEventListener('click', () => {
            isManualScrolling = true;
            if (manualScrollTimeout) clearTimeout(manualScrollTimeout);
            
            // Immediate UI feedback
            tocLinks.forEach(l => l.classList.remove('active'));
            link.classList.add('active');
            
            // Re-enable observer after scroll finishes
            manualScrollTimeout = window.setTimeout(() => {
                isManualScrolling = false;
            }, 1000);
        });
    });

    // 2. Optimized Observer
    scrollSpyObserver = new IntersectionObserver((entries) => {
        if (isManualScrolling) return;

        // Get all headings that have passed the top threshold
        const passedHeadings = headings.filter(h => {
            const rect = h.getBoundingClientRect();
            return rect.top < 150; // Heading is near or above the top
        });

        if (passedHeadings.length > 0) {
            // The active one is the last one that has passed the threshold
            const activeHeading = passedHeadings[passedHeadings.length - 1];
            const activeId = activeHeading.id;

            tocLinks.forEach(link => {
                const href = link.getAttribute('href')?.slice(1);
                if (href === activeId) {
                    if (!link.classList.contains('active')) {
                        link.classList.add('active');
                        link.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                } else {
                    link.classList.remove('active');
                }
            });
        }
    }, {
        rootMargin: '0px 0px -80% 0px', // Monitor the top 20% of the viewport
        threshold: [0, 1]
    });

    headings.forEach(h => scrollSpyObserver?.observe(h));
  }
  // --- End ScrollSpy Logic ---

  // Optimized Search Logic with RequestAnimationFrame
  const allCards = Array.from(document.querySelectorAll('.skill-card')).map(card => ({
    element: card as HTMLElement,
    text: (card.querySelector('h2')?.textContent?.toLowerCase() || '') + ' ' + 
          (card.querySelector('p')?.textContent?.toLowerCase() || '')
  }));

  let searchTimeout: number | null = null;
  function filterSkills(query: string) {
    if (searchTimeout) cancelAnimationFrame(searchTimeout);
    
    searchTimeout = requestAnimationFrame(() => {
        const q = query.toLowerCase().trim();
        let visibleCount = 0;

        allCards.forEach(item => {
            const match = item.text.includes(q);
            item.element.classList.toggle('hidden', !match);
            if (match) visibleCount++;
        });

        // Update section visibility
        document.getElementById('personal-section')?.classList.toggle('hidden', !allCards.filter(c => c.element.dataset.type === 'personal' && !c.element.classList.contains('hidden')).length);
        document.getElementById('reference-section')?.classList.toggle('hidden', !allCards.filter(c => c.element.dataset.type === 'reference' && !c.element.classList.contains('hidden')).length);

        emptyState?.classList.toggle('hidden', visibleCount > 0);
        if (countBadge) countBadge.textContent = `${visibleCount} TOTAL`;
    });
  }

  // View Switching Logic with optimized transition curves
  function showDetail(skillName: string, triggerElement: HTMLElement) {
    document.querySelectorAll('.skill-detail').forEach(el => el.classList.add('hidden'));
    
    const detail = document.getElementById(`detail-${skillName}`);
    if (detail) {
        lastFocusedElement = triggerElement;
        currentScrollPos = window.scrollY;
        detail.classList.remove('hidden');
        
        // Initialize ScrollSpy
        initScrollSpy(detail);

        // Update document title for SEO/UX
        const skillDisplayName = detail.querySelector('h2')?.textContent || skillName;
        document.title = `${skillDisplayName} | Agent Skills`;
        
        // Use smoother transiton class
        listView?.classList.add('opacity-0', '-translate-y-4');
        setTimeout(() => {
            listView?.classList.add('hidden');
            footer?.classList.add('hidden');
            detailsContainer?.classList.remove('hidden');
            
            // Force reflow for clean animation
            detailsContainer?.offsetHeight; 
            
            requestAnimationFrame(() => {
                detailsContainer?.classList.remove('opacity-0', 'translate-y-4');
                window.scrollTo(0, 0);
                const backBtn = detail.querySelector('.back-to-list') as HTMLElement;
                backBtn?.focus();
            });
        }, 300);
        
        history.pushState({ skill: skillName }, '', `#${skillName}`);
    }
  }

  function hideDetail() {
    detailsContainer?.classList.add('opacity-0', 'translate-y-4');
    
    // Disconnect ScrollSpy
    if (scrollSpyObserver) {
        scrollSpyObserver.disconnect();
        scrollSpyObserver = null;
    }

    // Restore original title
    document.title = ORIGIN_TITLE;

    setTimeout(() => {
        detailsContainer?.classList.add('hidden');
        listView?.classList.remove('hidden');
        footer?.classList.remove('hidden');
        
        // Force reflow
        listView?.offsetHeight;

        requestAnimationFrame(() => {
            listView?.classList.remove('opacity-0', '-translate-y-4');
            window.scrollTo(0, currentScrollPos);
            if (lastFocusedElement) {
                lastFocusedElement.focus();
            }
        });
    }, 300);
    
    history.pushState({}, '', window.location.pathname);
  }

  // Optimized Scroll Listener
  let scrollTicking = false;
  window.addEventListener('scroll', () => {
    if (!scrollTicking) {
        window.requestAnimationFrame(() => {
            if (window.scrollY > 400) {
                backToTopBtn?.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            } else {
                backToTopBtn?.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
            scrollTicking = false;
        });
        scrollTicking = true;
    }
  });

  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // 1. Handle Copy Raw Button
    const copyRawBtn = target.closest('.copy-raw-btn') as HTMLButtonElement;
    if (copyRawBtn) {
        const skillName = copyRawBtn.dataset.skill || '';
        const originalContent = copyRawBtn.innerHTML;
        try {
            const response = await fetch(`/agent-skills/raw/${skillName}.md`);
            const text = await response.text();
            await navigator.clipboard.writeText(text);
            copyRawBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="hidden md:inline">COPIED!</span>
            `;
            setTimeout(() => copyRawBtn.innerHTML = originalContent, 2000);
        } catch (err) {
            console.error('Failed to copy raw content:', err);
        }
        return;
    }

    // 2. Handle Copy Install Button
    const copyBtn = target.closest('.copy-install-btn') as HTMLButtonElement;
    if (copyBtn) {
        const command = copyBtn.dataset.command || '';
        navigator.clipboard.writeText(command);
        const original = copyBtn.innerHTML;
        copyBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="hidden md:inline">COPIED!</span>
        `;
        setTimeout(() => copyBtn.innerHTML = original, 2000);
        return;
    }

    // 3. Handle Back to List Button
    if (target.closest('.back-to-list')) {
        hideDetail();
        return;
    }

    // 4. Handle Mobile TOC Toggle
    const tocToggle = target.closest('.mobile-toc-toggle') as HTMLButtonElement;
    if (tocToggle) {
        const content = tocToggle.nextElementSibling as HTMLElement;
        const icon = tocToggle.querySelector('.chevron-icon') as HTMLElement;
        const isExpanded = tocToggle.getAttribute('aria-expanded') === 'true';
        
        if (content && content.classList.contains('mobile-toc-content')) {
            const newExpanded = !isExpanded;
            tocToggle.setAttribute('aria-expanded', String(newExpanded));
            content.classList.toggle('hidden', !newExpanded);
            if (icon) {
                icon.style.transform = newExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }
        return;
    }

    // 5. Handle Skill Card Click (Personal only)
    const card = target.closest('.skill-card') as HTMLElement;
    if (card) {
        // If clicking other interactive elements inside card (like GitHub link), do nothing
        if (target.closest('a')) return;

        const type = card.dataset.type;
        const name = card.dataset.skillName || '';

        if (type === 'personal') {
            showDetail(name, card);
        }
        return;
    }
  });

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const card = target.closest('.skill-card') as HTMLElement;
    if (card && (e.key === 'Enter' || e.key === ' ')) {
        const type = card.dataset.type;
        if (type === 'personal') {
            e.preventDefault();
            const name = card.dataset.skillName || '';
            showDetail(name, card);
        }
    }
    if (e.key === 'Escape' && !detailsContainer?.classList.contains('hidden')) {
        hideDetail();
    }
  });

  searchInput?.addEventListener('input', (e) => {
    filterSkills((e.target as HTMLInputElement).value);
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
        searchInput.value = '';
        filterSkills('');
        searchInput.focus();
    }
  });

  window.addEventListener('popstate', (e) => {
    const hash = window.location.hash.slice(1);
    if (e.state?.skill) {
        const trigger = document.querySelector(`[data-skill-name="${e.state.skill}"]`) as HTMLElement || document.body;
        showDetail(e.state.skill, trigger);
    } else if (hash) {
        // If hash is not a skill but we are in detail view, let browser handle anchor jump
        const detailExists = document.getElementById(`detail-${hash}`);
        if (detailExists) {
            const trigger = document.querySelector(`[data-skill-name="${hash}"]`) as HTMLElement || document.body;
            showDetail(hash, trigger);
        }
    } else {
        hideDetail();
    }
  });

  window.addEventListener('load', () => {
    const hash = window.location.hash.slice(1);
    if (hash) {
        const detail = document.getElementById(`detail-${hash}`);
        if (detail) {
            const trigger = document.querySelector(`[data-skill-name="${hash}"]`) as HTMLElement || document.body;
            showDetail(hash, trigger);
        }
    }
  });
</script>
