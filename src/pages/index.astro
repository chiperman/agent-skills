---
import Layout from '../layouts/Layout.astro';
import SkillCard from '../components/SkillCard.astro';
import { getCollection } from 'astro:content';

const skills = (await getCollection('skills'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const totalCount = skills.length;
---

<Layout title="Agent Skills | My Library">
  <main class="min-h-[80vh]">
    <!-- Header -->
    <header class="mb-12 pt-8">
      <h1 class="text-4xl font-bold mb-3 text-notebook-ink tracking-tight">
        Agent Skills
      </h1>
      <p class="text-lg text-notebook-secondary font-medium">
        A collection of expert knowledge for AI agents.
      </p>
    </header>

    <!-- Search Section -->
    <div class="sticky top-4 z-20 mb-12">
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-notebook-secondary"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <input 
          type="text" 
          id="skill-search"
          placeholder="Search skills..." 
          class="w-full pl-11 pr-4 py-3 bg-white border border-notebook-decor focus:border-notebook-ink rounded-lg shadow-sm text-notebook-ink placeholder-notebook-secondary/60 focus:outline-none transition-all font-body text-base"
          autocomplete="off"
        />
        <div class="absolute inset-y-0 right-4 flex items-center">
            <span class="text-[10px] font-bold text-notebook-secondary bg-notebook-base px-2 py-1 rounded border border-notebook-decor" id="count-badge">
                {totalCount} TOTAL
            </span>
        </div>
      </div>
    </div>

    <!-- Skills Section -->
    <section id="skills-section" class="mb-16">
      <div id="skills-grid" class="flex flex-col gap-4">
        {skills.map(skill => (
          <SkillCard skill={skill} />
        ))}
      </div>
    </section>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20">
        <p class="text-notebook-secondary font-medium text-lg">No matches found.</p>
        <button id="clear-search" class="mt-2 text-notebook-ink underline hover:no-underline text-sm font-bold">Clear filters</button>
    </div>
  </main>

  <footer class="mt-20 py-12 text-center text-notebook-secondary border-t border-notebook-decor">
    <div class="text-xs font-bold tracking-widest uppercase">
      <p class="mb-4">© 2026 Agent Skills Repository</p>
      <div class="flex justify-center gap-6">
        <a href="https://github.com/chiperman/agent-skills" target="_blank" rel="noopener noreferrer" class="hover:text-notebook-ink transition-colors">
          GitHub
        </a>
        <a href="#" class="hover:text-notebook-ink transition-colors">
          Documentation
        </a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Search Logic
  const searchInput = document.getElementById('skill-search') as HTMLInputElement;
  const skillsSection = document.getElementById('skills-section');
  const emptyState = document.getElementById('empty-state');
  const countBadge = document.getElementById('count-badge');
  const clearBtn = document.getElementById('clear-search');
  
  // Skill Cards
  const skillCards = Array.from(document.querySelectorAll('.skill-card')).map(card => ({
    element: card as HTMLElement,
    text: card.getAttribute('data-skill-name')?.toLowerCase() + ' ' + 
          (card.querySelector('h2')?.textContent?.toLowerCase() || '') + ' ' + 
          (card.querySelector('p')?.textContent?.toLowerCase() || '')
  }));

  function filterSkills(query: string) {
    const q = query.toLowerCase().trim();
    let visibleCount = 0;

    skillCards.forEach(item => {
        const match = item.text.includes(q);
        item.element.classList.toggle('hidden', !match);
        if (match) visibleCount++;
    });

    // Toggle sections
    skillsSection?.classList.toggle('hidden', visibleCount === 0);

    // Toggle empty state
    emptyState?.classList.toggle('hidden', visibleCount > 0);
    
    // Update counter
    if (countBadge) countBadge.textContent = `${visibleCount} TOTAL`;
  }

  searchInput?.addEventListener('input', (e) => {
    filterSkills((e.target as HTMLInputElement).value);
  });

  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
        searchInput.value = '';
        filterSkills('');
        searchInput.focus();
    }
  });

  // Handle Hash on Load
  window.addEventListener('load', () => {
    const hash = window.location.hash.slice(1);
    if (hash) {
        const targetCard = document.querySelector(`.skill-card[data-skill-name="${hash}"]`);
        if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const header = targetCard.querySelector('.header-section') as HTMLElement;
            if (header && !targetCard.classList.contains('expanded')) {
                header.click();
            }
        }
    }
  });
</script>
