---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Agent Skills | My Library",
	description = "A collection of expert knowledge and automation skills for AI agents."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://chiperman.github.io/agent-skills/");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/agent-skills/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}/og-image.png`, Astro.site)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(`${import.meta.env.BASE_URL}/og-image.png`, Astro.site)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
		
		<ClientRouter />
	</head>
	<body class="bg-notebook-base bg-page-texture min-h-dvh font-body text-notebook-ink p-4 md:p-8 selection:bg-notebook-interactive/20">
		<slot />

		<!-- Floating Back to Top -->
		<button 
			id="back-to-top" 
			class="fixed bottom-8 right-8 p-4 bg-notebook-ink text-notebook-base rounded-xl shadow-xl hover:bg-notebook-interactive transition-all duration-500 opacity-0 translate-y-10 pointer-events-none z-50 flex items-center justify-center transform-gpu"
			title="Back to Top"
			aria-label="Back to top"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
		</button>

		<script src="../scripts/main.ts"></script>
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	:root {
		--notebook-base: #fdfcfb;
		--notebook-grid: #f7f3f0;
		--notebook-decor: #e8e2dd;
		--notebook-ink: #3a3430;
		--notebook-secondary: #736b63;
		--notebook-interactive: #b56d4d;
	}
	
	@layer base {
		h1, h2, h3, h4 {
			@apply font-heading text-balance;
		}
		p {
			@apply text-pretty;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*, ::before, ::after {
			animation-delay: -1ms !important;
			animation-duration: 1ms !important;
			animation-iteration-count: 1 !important;
			background-attachment: initial !important;
			scroll-behavior: auto !important;
			transition-duration: 0s !important;
			transition-delay: 0s !important;
		}
	}

	html {
		scroll-behavior: smooth;
	}

	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--notebook-base);
	}
	::-webkit-scrollbar-thumb {
		background: var(--notebook-decor);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--notebook-secondary);
	}

	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>
