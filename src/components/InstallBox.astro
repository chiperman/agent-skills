---
interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="mb-12 p-px bg-notebook-decor/30 rounded-xl border border-notebook-decor/50">
  <div class="bg-gray-50/30 p-6 rounded-xl">
    <div class="flex items-center justify-between mb-4">
      <h4 class="text-[10px] font-black text-notebook-secondary uppercase tracking-[0.25em] opacity-70">CLI Installation</h4>
      <button 
        class="copy-install-btn group/btn flex items-center gap-2 px-3 md:px-4 py-2 text-notebook-base bg-notebook-ink hover:bg-notebook-secondary transition-all rounded-xl shadow-sm active:scale-95 font-bold text-[11px] tracking-widest whitespace-nowrap"
        data-command={command}
        aria-label="Copy installation command"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <span class="hidden md:block">COPY COMMAND</span>
      </button>
    </div>

    <div class="flex items-center py-4 bg-white border border-notebook-decor rounded-lg shadow-inner ring-1 ring-black/5 overflow-x-auto no-scrollbar group/install">
      <div class="pl-4 shrink-0 flex items-center justify-center translate-y-[0.5px]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 text-notebook-ink/40" aria-hidden="true"><polyline points="4 17 10 11 4 5"/></svg>
      </div>
      <code class="block w-full pl-3 pr-4 text-sm font-mono text-notebook-ink whitespace-nowrap tabular-nums leading-none">{command}</code>
    </div>
  </div>
</div>
