---
import { type CollectionEntry, render } from 'astro:content';

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const { Content, headings } = await render(skill);
const hasContent = headings.length > 0 || (skill.body?.trim()?.length ?? 0) > 0;
---

<div id={`detail-${skill.data.name}`} class="skill-detail hidden pb-32">
  <!-- Detail Header/Breadcrumb -->
  <div class="mb-8 flex items-center gap-3">
    <button class="back-to-list flex items-center gap-2 text-notebook-secondary hover:text-notebook-ink transition-colors font-bold text-xs uppercase tracking-widest active:scale-95" aria-label="Go back to skill library">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Back to Library
    </button>
  </div>

  <div class="max-w-4xl">
    <header class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-4xl font-bold text-notebook-ink font-heading leading-tight">
          {skill.data.name}
        </h2>
        <div class="flex gap-4">
            {skill.data.type === 'personal' && (
              <>
                <button 
                  class="copy-raw-btn flex items-center gap-2 px-4 py-2 text-[11px] font-bold tracking-widest border border-notebook-decor text-notebook-secondary hover:text-notebook-ink hover:border-notebook-ink transition-all rounded-xl bg-white shadow-sm active:scale-95"
                  data-skill={skill.data.name}
                  aria-label="Copy Raw Markdown"
                  title="Copy Raw Markdown"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  COPY
                </button>
                <a 
                    href={`/agent-skills/downloads/${skill.data.name}.zip`}
                    class="flex items-center gap-2 px-4 py-2 text-[11px] font-bold tracking-widest border border-notebook-decor text-notebook-secondary hover:text-notebook-ink hover:border-notebook-ink transition-all rounded-xl bg-white shadow-sm active:scale-95"
                    aria-label="Download Assets (.zip)"
                    title="Download Assets (.zip)"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    DOWNLOAD
                </a>
              </>
            )}
            {skill.data.github_url && (
              <a 
                  href={skill.data.github_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 px-4 py-2 text-[11px] font-bold tracking-widest border border-notebook-decor text-notebook-secondary hover:text-notebook-ink hover:border-notebook-ink transition-all rounded-xl bg-white shadow-sm active:scale-95"
                  aria-label="View on GitHub"
                  title="View on GitHub"
              >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                  GITHUB
              </a>
            )}
        </div>
      </div>
      <p class="text-xl text-notebook-secondary font-medium leading-relaxed max-w-2xl">
        {skill.data.description}
      </p>
    </header>

    <!-- Installation -->
    {skill.data.install_command && (
      <div class="mb-12 p-px bg-notebook-decor/30 rounded-xl border border-notebook-decor/50">
        <div class="bg-gray-50/30 p-6 rounded-xl">
            <div class="flex items-center justify-between mb-4">
                <h4 class="text-[10px] font-black text-notebook-secondary uppercase tracking-[0.25em] opacity-70">CLI Installation</h4>
                <button 
                    class="copy-install-btn group/btn flex items-center gap-2 px-4 py-2 text-notebook-base bg-notebook-ink hover:bg-notebook-secondary transition-all rounded-xl shadow-sm active:scale-95 font-bold text-[11px] tracking-widest"
                    data-command={skill.data.install_command}
                    aria-label="Copy installation command"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 group-hover/btn:rotate-12 transition-transform" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    COPY COMMAND
                </button>
            </div>
            <div class="relative group/install">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 text-notebook-ink/40" aria-hidden="true"><polyline points="4 17 10 11 4 5"/></svg>
                </div>
                <code class="block w-full pl-10 pr-4 py-4 bg-white border border-notebook-decor rounded-lg text-sm font-mono text-notebook-ink overflow-x-auto whitespace-nowrap shadow-inner ring-1 ring-black/5 tabular-nums">
                {skill.data.install_command}
                </code>
            </div>
        </div>
      </div>
    )}

    <!-- Content -->
    {hasContent && (
      <article class="prose prose-notebook max-w-none">
        <Content />
      </article>
    )}
  </div>
</div>
