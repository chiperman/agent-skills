---
import { type CollectionEntry, render } from 'astro:content';
import ActionButton from './ActionButton.astro';
import InstallBox from './InstallBox.astro';

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const { Content, headings } = await render(skill);
const hasContent = headings.length > 0 || (skill.body?.trim()?.length ?? 0) > 0;
---

<div class="skill-detail w-full">
  <div class="lg:grid lg:grid-cols-[280px_minmax(0,896px)_1fr] items-start lg:gap-x-12 xl:gap-x-20">
    <!-- Sidebar TOC (Desktop) - Left Column -->
    <aside class="hidden lg:block sticky top-8 self-start max-h-[calc(100vh-4rem)] overflow-y-auto toc-sidebar no-scrollbar pr-4">
      {headings.length > 0 && (
        <div class="w-full">
          <nav class="p-6 bg-white/50 backdrop-blur-sm rounded-2xl border border-notebook-decor/60 shadow-sm mb-12">
            <h4 class="text-[10px] font-black text-notebook-secondary uppercase tracking-[0.2em] mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="3" y1="12" y2="12"/><line x1="21" x2="3" y1="18" y2="18"/></svg>
              Directory
            </h4>
            <ul class="space-y-3">
              {headings.map((heading) => (
                <li style={`padding-left: ${(heading.depth - 2) * 12}px`}>
                  <a 
                    href={`#${heading.slug}`}
                    class="toc-link block text-sm font-medium text-notebook-secondary hover:text-notebook-interactive transition-all border-l-2 border-transparent pl-3 -ml-3 leading-snug"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}
    </aside>

    <!-- Main Content Area - Center Column -->
    <div class="px-4 lg:px-0">
      <!-- Detail Header/Breadcrumb -->
      <div class="mb-8 flex items-center gap-3">
        <a href={import.meta.env.BASE_URL} class="back-to-list flex items-center gap-2 text-notebook-secondary hover:text-notebook-ink transition-colors font-bold text-xs uppercase tracking-widest active:scale-95" aria-label="Go back to skill library">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          Back to Library
        </a>
      </div>

      <header class="mb-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8">
          <h2 class="text-3xl md:text-4xl font-bold text-notebook-ink font-heading leading-tight" transition:name={`skill-title-${skill.data.name}`}>
            {skill.data.name}
          </h2>
          <div class="flex items-center gap-3 md:gap-4">
              {skill.data.type === 'personal' && (
                <>
                  <ActionButton 
                    class="copy-raw-btn" 
                    label="COPY" 
                    title="Copy Raw Markdown" 
                    data-raw-url={skill.data.rawUrl}
                  >
                    <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  </ActionButton>
                  <ActionButton 
                    href={skill.data.zipUrl} 
                    label="DOWNLOAD" 
                    title="Download Assets (.zip)"
                  >
                    <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                  </ActionButton>
                </>
              )}
              {skill.data.github_url && (
                <ActionButton 
                  href={skill.data.github_url} 
                  label="GITHUB" 
                  title="View on GitHub" 
                  target="_blank" 
                  rel="noopener noreferrer"
                >
                  <svg slot="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                </ActionButton>
              )}
          </div>
        </div>
        <p class="text-xl text-notebook-secondary font-medium leading-relaxed max-w-2xl">
          {skill.data.description}
        </p>
      </header>

      <!-- Installation -->
      {skill.data.install_command && (
        <InstallBox command={skill.data.install_command} />
      )}

      <!-- Mobile TOC -->
      {headings.length > 0 && (
        <nav class="lg:hidden mb-12 bg-white border border-notebook-decor rounded-2xl shadow-sm overflow-hidden transition-all duration-300">
          <button 
            class="mobile-toc-toggle w-full px-6 py-4 flex items-center justify-between group"
            aria-expanded="false"
            aria-controls={`toc-content-${skill.data.name}`}
          >
            <h4 class="text-[10px] font-black text-notebook-secondary uppercase tracking-[0.2em] group-hover:text-notebook-ink transition-colors flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="3" y1="12" y2="12"/><line x1="21" x2="3" y1="18" y2="18"/></svg>
              Directory
            </h4>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon size-3.5 text-notebook-secondary group-hover:text-notebook-ink transition-all duration-300 transform" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div id={`toc-content-${skill.data.name}`} class="mobile-toc-content hidden border-t border-notebook-decor/50 bg-notebook-base/30">
            <ul class="px-6 py-5 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
              {headings.map((heading) => (
                <li style={`padding-left: ${(heading.depth - 2) * 12}px`}>
                  <a 
                    href={`#${heading.slug}`}
                    class="block text-sm font-medium text-notebook-secondary hover:text-notebook-interactive transition-colors"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )}

      <!-- Content -->
      {hasContent && (
        <article class="prose prose-notebook max-w-none">
          <Content />
        </article>
      )}
    </div>

    <!-- Right Column - Spacer to ensure center alignment -->
    <div class="hidden lg:block"></div>
  </div>
</div>

<style>
  .toc-sidebar {
    scrollbar-width: thin;
    scrollbar-color: var(--notebook-decor) transparent;
  }
  
  .toc-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  
  .toc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .toc-sidebar::-webkit-scrollbar-thumb {
    background-color: var(--notebook-decor);
    border-radius: 20px;
    transition: background-color 0.3s ease;
  }
  
  .toc-sidebar::-webkit-scrollbar-thumb:hover {
    background-color: var(--notebook-interactive);
  }

  .toc-link.active {
    color: var(--notebook-ink);
    border-left-color: var(--notebook-interactive);
    background-color: rgba(181, 109, 77, 0.05);
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
