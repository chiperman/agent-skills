---
import { type CollectionEntry } from 'astro:content';

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const isPersonal = skill.data.type === 'personal';
---

<div 
    class={`skill-card group bg-white border border-notebook-decor rounded-xl shadow-sm hover:shadow-md hover:border-notebook-ink transition-all duration-300 overflow-hidden cursor-pointer ${isPersonal ? 'skill-trigger' : 'external-trigger'}`}
    data-skill-name={skill.data.name}
    data-url={skill.data.github_url}
    data-type={skill.data.type}
>
    <div class="p-5 md:p-6 flex items-start gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <h2 class="text-xl md:text-2xl font-bold text-notebook-ink font-heading group-hover:text-notebook-interactive transition-colors">
            {skill.data.name}
          </h2>
          {!isPersonal && (
             <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-notebook-secondary opacity-50 group-hover:opacity-100 transition-opacity"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          )}
        </div>
        
        <p class="text-notebook-secondary text-sm md:text-base font-body leading-relaxed line-clamp-2">
          {skill.data.description}
        </p>
      </div>

      <div class="p-2 text-notebook-decor group-hover:text-notebook-ink transition-colors">
          {isPersonal ? (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          ) : (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          )}
      </div>
    </div>
</div>
